# --- Active LLM (OpenAI-compatible endpoint). Model swap = these 3 lines only. ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-groq-key-here
LLM_MODEL=openai/gpt-oss-120b

# --- Switching provider = replace the 3 LLM_* lines above (nothing switches automatically). ---
# The model must support tool (function) calling. Example — Ollama Cloud, tested end to end:
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=<your Ollama key>
# LLM_MODEL=gpt-oss:120b

# --- Graph ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
GRAPH_NAME=desk